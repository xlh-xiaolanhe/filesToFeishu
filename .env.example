# Copy to .env; never commit real credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional default wiki parent URL, e.g. https://example.feishu.cn/wiki/ABC123
FEISHU_PARENT_URL=
# Optional application-bot notifications. Disabled until explicitly enabled.
FEISHU_NOTIFY_ENABLED=false
# open_id (recommended for a user), user_id, union_id, email, or chat_id (group).
FEISHU_NOTIFY_RECEIVE_ID_TYPE=open_id
FEISHU_NOTIFY_RECEIVE_ID=
DATA_DIR=.data
DOCLING_ARTIFACTS_PATH=.models
# Optional acquisition limits; final offline ZIP must fit the 20 MB Feishu file upload limit.
WECHAT_MAX_HTML_BYTES=8388608
WECHAT_MAX_ASSET_BYTES=20971520
WECHAT_MAX_TOTAL_BYTES=104857600
WECHAT_TIMEOUT=30
